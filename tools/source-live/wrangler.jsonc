{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mbnime-source-live",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://anime.mbnpro.ir"
  },
  "durable_objects": {
    "bindings": [{ "name": "SOURCE_SESSION", "class_name": "SourceGateway" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SourceGateway"] }],
  "observability": { "enabled": false }
}
